# Copy to `frontend/.env` (Vite loads env from this folder).

# Backend API (required for deployed demo)
VITE_API_BASE=http://127.0.0.1:8000/api

# Optional: server-side PDF parse (onboarding uses client pdf.js by default — recommended for Vercel)
# VITE_TRANSCRIPTPARSER_API=http://127.0.0.1:8000/api/parse-transcript
# VITE_TRANSCRIPTPARSER_PREFER_SERVER=true
